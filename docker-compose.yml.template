services:
  amenity-server:
    build: .
    restart: unless-stopped
    environment:
      PORT: 8081
      OSM_AMENITY_DATA_DIR: /osm/data
      OSM_AMENITY_SOURCE_PBF: /source/region.osm.pbf
      OSM_AMENITY_AMENITIES: toilets
      # Defaults: precision 5, 256 MB cache, hourly update-loop wake interval.
      # For Japan Geofabrik daily replication:
      # OSM_AMENITY_UPDATE_BASE_URL: https://download.geofabrik.de/asia/japan-updates
      # OSM_AMENITY_REEXTRACT_EVERY_SECONDS: 604800
      # LOG_VERBOSITY: info
    ports:
      - "127.0.0.1:8081:8081"
    volumes:
      # Writable pipeline root: active data link, immutable generations, and work/.
      - ${OSM_AMENITY_PIPELINE_DIR:-./pipeline}:/osm:rw
      # Retained source PBF is mounted read-only at the path supplied above.
      - ${OSM_AMENITY_SOURCE_PBF_HOST:?Set OSM_AMENITY_SOURCE_PBF_HOST to a retained PBF file}:/source/region.osm.pbf:ro

# Add the unmodified Overpass-Proxy as another service and point UPSTREAM_URLS
# at http://amenity-server:8081/api/interpreter followed by remote fallback URLs.
# Docker packaging is provided for deployment; it has not been built or tested
# as part of local verification.
