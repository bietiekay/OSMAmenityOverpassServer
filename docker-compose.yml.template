version: '3.3'
services:
  amenity-server:
    build: .
    restart: unless-stopped
    environment:
      # Required
      PORT: 8081
      OSM_AMENITY_DATA_DIR: /data
      # A comma-separated list of amenity values to serve (normalised trim().toLowerCase())
      OSM_AMENITY_AMENITIES: toilets
      # Geohash shard precision (= proxy tile precision, default 5)
      # OSM_AMENITY_SHARD_PRECISION: 5
      # LRU byte budget for the in-process shard cache (MB)
      # OSM_AMENITY_SHARD_CACHE_MB: 256
      # Update loop: wake interval in seconds (default hourly). The update source is always
      # the minute replication files; the interval only controls how often catch-up runs.
      # OSM_AMENITY_UPDATE_INTERVAL_SECONDS: 3600
      # OSM_AMENITY_UPDATE_BASE_URL: https://planet.openstreetmap.org/replication
      # Weekly drift-guard re-extract trigger (0 = disabled)
      # OSM_AMENITY_REEXTRACT_EVERY_SECONDS: 604800
      # Optional: reach the Overpass-Proxy Redis directly to invalidate affected tile keys
      # after each update batch (key schema: tile:<amenity>:<geohash5>)
      # OSM_AMENITY_REDIS_URL: redis://redis:6379
      # LOG_VERBOSITY: info
    ports:
      - "127.0.0.1:8081:8081"
    volumes:
      # The index is produced by scripts/extract.mjs on the host machine (not inside this container).
      - ./data:/data:ro

# ---------------------------------------------------------------------------
# Full stack: add the unmodified Overpass-Proxy in front, pointing at both the
# local amenity-server (preferred, via EWMA latency) and the remote pool.
#
#   proxy:
#     image: <your overpass-proxy build>
#     environment:
#       PORT: 8080
#       REDIS_URL: redis://redis:6379
#       UPSTREAM_URLS: http://amenity-server:8081/api/interpreter, https://overpass-api.de/api/interpreter, https://overpass.kumi.systems/api/interpreter
#     ports:
#       - "127.0.0.1:5002:8080"
#
#   redis:
