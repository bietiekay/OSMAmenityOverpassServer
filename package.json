{
  "name": "osm-amenity-overpass-server",
  "version": "0.1.0",
  "description": "Standalone, self-updating, Overpass-compatible amenity data server with a geohash-sharded on-disk index (worldwide OSM planet).",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "extract": "node scripts/extract.mjs",
    "make-fixture": "node scripts/make-fixture.mjs",
    "parity": "node scripts/parity.mjs",
    "verify": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.6.2",
    "ngeohash": "^0.6.0",
    "pino": "^10.1.0",
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.16"
  }
}
