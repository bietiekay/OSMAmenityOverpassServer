{
  "name": "osm-amenity-overpass-server",
  "version": "0.1.1",
  "description": "Standalone, self-updating, Overpass-compatible amenity data server with a transactional SQLite spatial index (worldwide OSM planet).",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "check-index": "node scripts/check-index.mjs",
    "extract": "node scripts/extract.mjs",
    "make-fixture": "node scripts/make-fixture.mjs",
    "parity": "node scripts/parity.mjs",
    "verify": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "fastify": "^5.12.7",
    "ngeohash": "^0.6.4",
    "pino": "^10.4.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
