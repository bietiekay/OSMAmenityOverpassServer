# Japan example. Use absolute paths and the exact feed from the source header.
# This file uses syntax shared by systemd EnvironmentFile and POSIX shells.
PORT=8081
OSM_AMENITY_DATA_DIR=/var/lib/osm-amenity/japan/data
OSM_AMENITY_SOURCE_PBF=/srv/osm-sources/japan-2026-10-14.osm.pbf
OSM_AMENITY_AMENITIES=toilets
# Compatibility value; SQLite uses an RTree, not geohash files.
OSM_AMENITY_SHARD_PRECISION=5
# SQLite page-cache budget per HTTP query connection (MiB).
OSM_AMENITY_SHARD_CACHE_MB=256
OSM_AMENITY_UPDATE_BASE_URL=https://download.geofabrik.de/asia/japan-updates
# In watch mode this is also the maximum small-batch collection window.
# For a planet minute feed, 7200 seconds targets about 120 diffs per batch.
OSM_AMENITY_UPDATE_INTERVAL_SECONDS=3600
# Full baseline rebuilds retained; normal diffs update the active DB in place.
OSM_AMENITY_GENERATIONS_TO_KEEP=2
# Concurrent baseline lookup batches; one database writer.
OSM_AMENITY_UPDATE_WORKERS=1
OSM_AMENITY_REEXTRACT_ENABLED=false
# If enabled, 15552000 seconds is 180 days (about six months).
OSM_AMENITY_REEXTRACT_EVERY_SECONDS=15552000
# Optional: supply a separately retained, newer PBF. Regional feeds require
# this path. For planet/minute only, omitting it downloads the current planet
# and MD5 into the pipeline source-snapshots/ directory when due.
# OSM_AMENITY_REEXTRACT_SOURCE_PBF=/srv/osm-sources/planet-new.osm.pbf
# OSM_AMENITY_REEXTRACT_SOURCE_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf
# OSM_AMENITY_REEXTRACT_CHECKSUM_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf.md5
LOG_VERBOSITY=info
