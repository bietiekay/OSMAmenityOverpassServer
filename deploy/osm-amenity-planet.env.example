# Fresh global amenity=toilets SQLite baseline. No migration from OAM1.
# Use absolute paths matching the import and the service account permissions.
# The feed URL must exactly match the baseline's recorded descriptor.
# Easy Setup derives it; planet PBFs without a cursor need a safe bootstrap first.
PORT=8081
OSM_AMENITY_DATA_DIR=/var/lib/osm-amenity/planet/data
OSM_AMENITY_SOURCE_PBF=/srv/osm-sources/planet-initial.osm.pbf
OSM_AMENITY_AMENITIES=toilets
# Compatibility value, not spatial-index/file-count tuning.
OSM_AMENITY_SHARD_PRECISION=5
# SQLite page cache per HTTP query connection, in MiB.
OSM_AMENITY_SHARD_CACHE_MB=256
OSM_AMENITY_UPDATE_BASE_URL=https://planet.openstreetmap.org/replication/minute
OSM_AMENITY_UPDATE_INTERVAL_SECONDS=3600
# Baseline lookup concurrency; SQLite has one update writer.
OSM_AMENITY_UPDATE_WORKERS=1
# Full baseline generations; individual diff states need backups.
OSM_AMENITY_GENERATIONS_TO_KEEP=2
OSM_AMENITY_REEXTRACT_ENABLED=false
OSM_AMENITY_REEXTRACT_EVERY_SECONDS=15552000
# Optional newer immutable source for scheduled rebuilds.
# Otherwise a current planet is downloaded to the writable pipeline root.
# OSM_AMENITY_REEXTRACT_SOURCE_PBF=/srv/osm-sources/planet-new.osm.pbf
LOG_VERBOSITY=info
